{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true,
      "environment": {}
    },
    "mui-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mui/mcp@latest"],
      "enabled": true,
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": ["pnpm", "exec", "playwright-mcp"],
      "enabled": true,
      "environment": {}
    }
  }
}
