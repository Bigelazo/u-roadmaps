generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Course {
  code            String           @id @db.VarChar(20)
  name            String           @db.VarChar(200)
  department      String           @db.VarChar(200)
  courseOfferings CourseOffering[]
}

model CourseOffering {
  id           String          @id @default(uuid()) @db.Uuid
  courseCode   String          @db.VarChar(20)
  year         Int
  semester     Int
  course       Course          @relation(fields: [courseCode], references: [code], onDelete: Cascade)
  roadmap      Roadmap?
  participants Participation[]

  @@unique([courseCode, year, semester])
  @@index([courseCode])
}

model Roadmap {
  id                     String                        @id @default(uuid()) @db.Uuid
  closedAt               DateTime?                     @db.Timestamptz(3)
  // Permanent attribution; absent only for Roadmaps created before it was recorded.
  creatorId              String?                       @db.Uuid
  creator                User?                         @relation("RoadmapCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  closureTeachingStaff   RoadmapClosureTeachingStaff[]
  courseOfferingId       String                        @unique @db.Uuid
  courseOffering         CourseOffering                @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  nodeTypes              NodeType[]
  roadmapNodes           RoadmapNode[]
  simulatedCompletions   SimulatedCompletion[]
  visits                 RoadmapVisit[]
  routeKnowledge         RouteNoticeKnowledge[]
  nodeLifecycleKnowledge NodeLifecycleKnowledge[]

  @@unique([id, courseOfferingId])
}

// Teaching staff with an active Participation when the Roadmap closed, recorded
// once by the closure transaction and never updated afterwards. Deleting a User
// still cascades: development resets delete fixture Users that may appear here.
model RoadmapClosureTeachingStaff {
  roadmapId             String                       @db.Uuid
  userId                String                       @db.Uuid
  institutionalPosition InstitutionalCoursePosition?
  roadmap               Roadmap                      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roadmapId, userId])
  @@index([userId])
}

// The official dates that make a Course offering read-only are published once
// per Academic term, not once per roadmap. They are synchronized from the
// FCFM academic calendar before the end of the term.
model AcademicTerm {
  year              Int
  semester          Int
  lastClassDay      DateTime @db.Date
  examStartDay      DateTime @db.Date
  examEndDay        DateTime @db.Date
  roadmapFreezeDate DateTime @db.Date
  sourcePageUrl     String
  sourcePdfUrl      String
  syncedAt          DateTime @updatedAt

  @@id([year, semester])
}

model NodeType {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(120)
  normalizedName String        @db.VarChar(120)
  icon           String        @db.VarChar(64)
  color          String        @db.VarChar(7)
  isPredefined   Boolean       @default(false)
  roadmapId      String?       @db.Uuid
  roadmap        Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  nodes          RoadmapNode[]

  @@unique([roadmapId, normalizedName])
  @@index([isPredefined])
}

model RoadmapNode {
  id                   String                    @id @default(uuid()) @db.Uuid
  roadmapId            String                    @db.Uuid
  nodeTypeId           String                    @db.Uuid
  title                String                    @db.VarChar(240)
  description          String?
  positionX            Float
  positionY            Float
  isVisible            Boolean                   @default(true)
  isTeacherBlocked     Boolean                   @default(false)
  teacherUnlockOn      DateTime?                 @db.Date
  roadmap              Roadmap                   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  nodeType             NodeType                  @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  outgoingDependencies Dependency[]              @relation("OutgoingDependencies")
  incomingDependencies Dependency[]              @relation("IncomingDependencies")
  resources            Resource[]
  contentKnowledge     NodeContentKnowledge[]
  titleKnowledge       NodeTitleKnowledge[]
  resourceKnowledge    ResourceNoticeKnowledge[]
  completions          Completion[]
  simulatedCompletions SimulatedCompletion[]
  changeReviews        NodeChangeReview[]

  @@unique([id, roadmapId])
  @@index([roadmapId])
  @@index([nodeTypeId])
  @@index([teacherUnlockOn])
}

model Dependency {
  id           String      @id @default(uuid()) @db.Uuid
  sourceNodeId String      @db.Uuid
  targetNodeId String      @db.Uuid
  sourceHandle String      @default("right") @db.VarChar(6)
  targetHandle String      @default("left") @db.VarChar(6)
  sourceNode   RoadmapNode @relation("OutgoingDependencies", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   RoadmapNode @relation("IncomingDependencies", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([targetNodeId])
}

model Resource {
  id              String       @id @default(uuid()) @db.Uuid
  roadmapNodeId   String       @db.Uuid
  title           String       @db.VarChar(240)
  url             String
  type            ResourceType
  fileKey         String?      @unique @db.Uuid
  fileContentType String?      @db.VarChar(255)
  roadmapNode     RoadmapNode  @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([roadmapNodeId])
}

model User {
  id                     String                        @id @default(uuid()) @db.Uuid
  name                   String                        @db.VarChar(200)
  institutionalEmail     String                        @unique @db.VarChar(320)
  rut                    String?                       @unique @db.VarChar(20)
  notices                RoadmapNotice[]
  noticeEffects          NoticeDeliveryEffect[]
  roadmapVisits          RoadmapVisit[]
  contentKnowledge       NodeContentKnowledge[]
  titleKnowledge         NodeTitleKnowledge[]
  resourceKnowledge      ResourceNoticeKnowledge[]
  routeKnowledge         RouteNoticeKnowledge[]
  nodeLifecycleKnowledge NodeLifecycleKnowledge[]
  nodeChangeReviews      NodeChangeReview[]
  participations         Participation[]
  completions            Completion[]
  createdRoadmaps        Roadmap[]                     @relation("RoadmapCreator")
  closureTeachingStaff   RoadmapClosureTeachingStaff[]
}

model VtiLoginTransaction {
  state     String   @id @db.Uuid
  expiresAt DateTime

  @@index([expiresAt])
}

model Participation {
  id                    String                       @id @default(uuid()) @db.Uuid
  userId                String                       @db.Uuid
  courseOfferingId      String                       @db.Uuid
  institutionalPosition InstitutionalCoursePosition?
  role                  ParticipationRole
  isActive              Boolean                      @default(true)
  noticeResetAt         DateTime?                    @db.Timestamptz(3)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseOffering        CourseOffering               @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  simulatedCompletions  SimulatedCompletion[]

  @@unique([userId, courseOfferingId])
  @@unique([id, courseOfferingId])
  @@index([courseOfferingId, role])
}

model Completion {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  roadmapNodeId String      @db.Uuid
  completedAt   DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNode   RoadmapNode @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapNodeId])
  @@index([roadmapNodeId])
}

model SimulatedCompletion {
  id               String        @id @default(uuid()) @db.Uuid
  participationId  String        @db.Uuid
  courseOfferingId String        @db.Uuid
  roadmapId        String        @db.Uuid
  roadmapNodeId    String        @db.Uuid
  completedAt      DateTime      @default(now())
  participation    Participation @relation(fields: [participationId, courseOfferingId], references: [id, courseOfferingId], onDelete: Cascade)
  roadmap          Roadmap       @relation(fields: [roadmapId, courseOfferingId], references: [id, courseOfferingId], onDelete: Cascade)
  roadmapNode      RoadmapNode   @relation(fields: [roadmapNodeId, roadmapId], references: [id, roadmapId], onDelete: Cascade)

  @@unique([participationId, roadmapNodeId])
  @@index([roadmapNodeId])
  @@index([participationId, roadmapId])
}

enum ResourceType {
  FILE
  LINK
  VIDEO
}

enum ParticipationRole {
  STUDENT
  TEACHER
}

// Notices retain context even if the Roadmap or Participation later disappears.
model RoadmapNotice {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String
  targetKey        String?
  recipientId      String    @db.Uuid
  recipient        User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  roadmapId        String    @db.Uuid
  courseOfferingId String    @db.Uuid
  subject          String
  body             String
  data             Json
  occurredAt       DateTime  @db.Timestamptz(3)
  availableAt      DateTime  @default(now()) @db.Timestamptz(3)
  acknowledgedAt   DateTime? @db.Timestamptz(3)

  @@unique([eventId, recipientId])
  @@index([recipientId, availableAt, id])
  @@index([recipientId, roadmapId, acknowledgedAt])
}

// The canvas marks a Node while it has notice targets newer than the
// recipient's last opening of that Node, independently of Roadmap recognition.
model NodeChangeReview {
  recipientId String      @db.Uuid
  nodeId      String      @db.Uuid
  reviewedAt  DateTime    @db.Timestamptz(3)
  recipient   User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  node        RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([recipientId, nodeId])
  @@index([nodeId])
}

model RoadmapVisit {
  lastRecognizedOpeningSequence BigInt  @default(0)
  recipientId                   String  @db.Uuid
  roadmapId                     String  @db.Uuid
  recipient                     User    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  roadmap                       Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@id([recipientId, roadmapId])
}

model NoticeAcknowledgement {
  openingSequence     BigInt    @default(autoincrement())
  recipientId         String    @db.Uuid
  operationId         String    @db.Uuid
  roadmapId           String    @db.Uuid
  openedAt            DateTime  @db.Timestamptz(3)
  noticeIds           String[]  @default([]) @db.Uuid
  contentSnapshots    Json      @default("[]")
  titleSnapshots      Json      @default("[]")
  resourceSnapshots   Json      @default("[]")
  routeSnapshots      Json      @default("[]")
  absorptionSnapshots Json      @default("[]")
  summary             Json      @default("null")
  recognizedAt        DateTime? @db.Timestamptz(3)

  @@id([recipientId, operationId])
  @@index([recipientId, openedAt])
}

// Idempotency receipts include repeats that have no individual Inbox row.
// Receipts survive title notice updates and withdrawals.
model NoticeDeliveryEffect {
  eventId     String
  recipientId String @db.Uuid
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([eventId, recipientId])
}

// One durable last-known title per recipient and Node, independent of Inbox rows.
model NodeTitleKnowledge {
  recipientId String      @db.Uuid
  nodeId      String      @db.Uuid
  knownTitle  String      @db.VarChar(240)
  recipient   User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  node        RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([recipientId, nodeId])
}

// Node target values have independent recipient baselines. Access also tracks
// the current projection atomically with Roadmap edits for deferred delivery.
model NodeContentKnowledge {
  recipientId     String      @db.Uuid
  nodeId          String      @db.Uuid
  target          String
  knownValue      String
  currentValue    String?
  knownTypeName   String?
  currentTypeName String?
  recipient       User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  node            RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([recipientId, nodeId, target])
}

// Recipient knowledge survives hiding and deletion until the Roadmap is removed.
model NodeLifecycleKnowledge {
  recipientId String  @db.Uuid
  roadmapId   String  @db.Uuid
  nodeId      String  @db.Uuid
  isKnown     Boolean @default(false)
  recipient   User    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@id([recipientId, roadmapId, nodeId])
}

// Resource identities survive removal so the recipient's known title remains available.
model ResourceNoticeKnowledge {
  recipientId String      @db.Uuid
  resourceId  String      @db.Uuid
  nodeId      String      @db.Uuid
  knownState  String?
  recipient   User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  node        RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([recipientId, resourceId])
}

// Route targets survive Dependency replacement and retain recipient baselines.
model RouteNoticeKnowledge {
  recipientId String  @db.Uuid
  roadmapId   String  @db.Uuid
  targetKey   String
  knownValue  String
  recipient   User    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@id([recipientId, roadmapId, targetKey])
}

enum InstitutionalCoursePosition {
  COURSE_PROFESSOR
  COORDINATING_PROFESSOR
  AUXILIARY_PROFESSOR
  TEACHING_ASSISTANT
  STUDENT
  OBSERVER
}
