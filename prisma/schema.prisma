generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Course {
  code            String           @id @db.VarChar(20)
  name            String           @db.VarChar(200)
  department      String           @db.VarChar(200)
  courseOfferings CourseOffering[]
}

model CourseOffering {
  id           String          @id @default(uuid()) @db.Uuid
  courseCode   String          @db.VarChar(20)
  year         Int
  semester     Int
  course       Course          @relation(fields: [courseCode], references: [code], onDelete: Cascade)
  roadmap      Roadmap?
  participants Participation[]

  @@unique([courseCode, year, semester])
  @@index([courseCode])
}

model Roadmap {
  id               String       @id @default(uuid()) @db.Uuid
  courseOfferingId String       @unique @db.Uuid
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  nodeTypes        NodeType[]
  roadmapNodes     RoadmapNode[]
}

model NodeType {
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @db.VarChar(120)
  normalizedName String        @db.VarChar(120)
  icon           String        @db.VarChar(64)
  color          String        @db.VarChar(7)
  isPredefined   Boolean       @default(false)
  roadmapId      String?       @db.Uuid
  roadmap        Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  nodes          RoadmapNode[]

  @@unique([roadmapId, normalizedName])
  @@index([isPredefined])
}

model RoadmapNode {
  id                   String       @id @default(uuid()) @db.Uuid
  roadmapId            String       @db.Uuid
  nodeTypeId           String       @db.Uuid
  title                String       @db.VarChar(240)
  description          String?
  positionX            Float
  positionY            Float
  isVisible            Boolean      @default(true)
  isTeacherBlocked     Boolean      @default(false)
  roadmap              Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  nodeType             NodeType     @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  outgoingDependencies Dependency[] @relation("OutgoingDependencies")
  incomingDependencies Dependency[] @relation("IncomingDependencies")
  resources            Resource[]
  completions          Completion[]

  @@index([roadmapId])
  @@index([nodeTypeId])
}

model Dependency {
  id           String      @id @default(uuid()) @db.Uuid
  sourceNodeId String      @db.Uuid
  targetNodeId String      @db.Uuid
  sourceHandle String      @default("right") @db.VarChar(6)
  targetHandle String      @default("left") @db.VarChar(6)
  sourceNode   RoadmapNode @relation("OutgoingDependencies", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   RoadmapNode @relation("IncomingDependencies", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([targetNodeId])
}

model Resource {
  id              String      @id @default(uuid()) @db.Uuid
  roadmapNodeId   String      @db.Uuid
  title           String      @db.VarChar(240)
  url             String
  type            ResourceType
  fileKey         String?     @unique @db.Uuid
  fileContentType String?     @db.VarChar(255)
  roadmapNode     RoadmapNode @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([roadmapNodeId])
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String          @db.VarChar(200)
  institutionalEmail String          @unique @db.VarChar(320)
  rut                String?         @unique @db.VarChar(20)
  participations     Participation[]
  completions        Completion[]
}

model VtiLoginTransaction {
  state     String   @id @db.Uuid
  expiresAt DateTime

  @@index([expiresAt])
}

model Participation {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  courseOfferingId String            @db.Uuid
  role             ParticipationRole
  isActive         Boolean           @default(true)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseOffering   CourseOffering    @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([userId, courseOfferingId])
  @@index([courseOfferingId, role])
}

model Completion {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  roadmapNodeId String      @db.Uuid
  completedAt   DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNode   RoadmapNode @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapNodeId])
  @@index([roadmapNodeId])
}

enum ResourceType {
  FILE
  LINK
  VIDEO
}

enum ParticipationRole {
  STUDENT
  TEACHER
}
