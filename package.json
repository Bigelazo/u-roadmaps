{
  "name": "u-roadmaps",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "dotenv -o -e .env.development -- prisma migrate deploy",
    "prisma:migrate": "dotenv -o -e .env.production -- prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:prepare": "prisma generate && prisma migrate deploy && prisma db seed",
    "dev:data:reset": "dotenv -o -e .env.development -- sh -c 'tsx --conditions react-server scripts/reset-development-data.ts --assert-environment && prisma migrate deploy && tsx --conditions react-server scripts/reset-development-data.ts'",
    "sync:academic-calendar": "tsx --conditions react-server scripts/sync-academic-calendar.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dagrejs/dagre": "^3.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@xyflow/react": "12.11.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "neverthrow": "^8.2.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.39.5",
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-neverthrow": "^1.1.4",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
