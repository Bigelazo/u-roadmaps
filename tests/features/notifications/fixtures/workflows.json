{
  "schemaVersion": 2,
  "provider": "Novu",
  "environment": "configured per deployment",
  "grouping": {
    "subscriberField": "subscriberId",
    "aggregationField": "payload.digestKey",
    "workflowIsolatesClass": true,
    "nodeKey": "roadmap:{roadmapId}:node:{nodeId}",
    "generalKey": "roadmap:{roadmapId}:general",
    "authorIsPartOfKey": false
  },
  "digestDefaults": {
    "mode": "regular-when-events-repeat",
    "windowSeconds": 60,
    "firstDelivery": "immediate",
    "repeatDelivery": "one summary after the window",
    "firstNotificationIsReplaced": false,
    "summaryIsOneInboxNotification": true
  },
  "projectionDefaults": {
    "handler": "Novu hosted In-App Code Step",
    "digestStepId": "digest",
    "inAppStepId": "in-app",
    "digestEventsSource": "steps.digest.events",
    "latestEvent": "event with the greatest payload.occurredAt; ties use the last event in Novu order",
    "eventCount": "sum of payload.eventCount for digest events; 1 for an immediate event",
    "actorName": "payload.actorName from the latest effective event",
    "dataIsAnEventList": false,
    "maxDataProperties": 10,
    "maxStringLength": 256
  },
  "workflows": [
    {
      "identifier": "roadmap-available",
      "class": "roadmap-availability",
      "delivery": "in-app",
      "digest": {
        "mode": "regular-when-events-repeat",
        "windowSeconds": 60,
        "aggregationField": "payload.digestKey",
        "keyFormat": "roadmap:{roadmapId}:general"
      },
      "steps": [
        { "id": "digest", "type": "digest" },
        {
          "id": "in-app",
          "type": "in-app-code",
          "handler": "novu/roadmap-available/in-app.step.tsx"
        }
      ],
      "input": {
        "roadmapId": "uuid",
        "courseCode": "string",
        "year": "number",
        "semester": "number",
        "targetKind": "roadmap",
        "changeKind": "roadmap-available",
        "occurredAt": "ISO-8601 UTC string",
        "eventCount": 1,
        "actorName": "string",
        "digestKey": "roadmap:{roadmapId}:general"
      },
      "inApp": {
        "singleSubject": "Roadmap disponible: {courseCode}",
        "singleBody": "{actorName} creó el roadmap de {courseCode}.",
        "summarySubject": "Resumen de cambios · Roadmap de {courseCode}",
        "summaryBody": "count + detalle del último evento",
        "data": [
          "roadmapId",
          "courseCode",
          "year",
          "semester",
          "targetKind",
          "changeKind",
          "occurredAt",
          "eventCount",
          "actorName"
        ]
      }
    },
    {
      "identifier": "roadmap-node-changed",
      "class": "node-change",
      "delivery": "in-app",
      "digest": {
        "mode": "regular-when-events-repeat",
        "windowSeconds": 60,
        "aggregationField": "payload.digestKey",
        "keyFormat": "roadmap:{roadmapId}:node:{nodeId}"
      },
      "steps": [
        { "id": "digest", "type": "digest" },
        {
          "id": "in-app",
          "type": "in-app-code",
          "handler": "novu/roadmap-node-changed/in-app.step.tsx"
        }
      ],
      "input": {
        "roadmapId": "uuid",
        "courseCode": "string",
        "year": "number",
        "semester": "number",
        "targetKind": "node | roadmap",
        "nodeId": "uuid",
        "nodeTitle": "string",
        "changeKind": "node-available | node-updated | node-retired | node-deleted | node-blocked",
        "occurredAt": "ISO-8601 UTC string",
        "eventCount": 1,
        "actorName": "string",
        "noticeTitle": "string",
        "noticeBody": "string",
        "digestKey": "roadmap:{roadmapId}:node:{nodeId}"
      },
      "inApp": {
        "singleSubject": "payload.noticeTitle",
        "singleBody": "{actorName} modificó un recurso en un Nodo del Roadmap de {courseCode}.",
        "summarySubject": "Resumen de cambios · Nodo «{nodeTitle}»",
        "summaryBody": "count + resource detail from latest effective event",
        "data": [
          "roadmapId",
          "courseCode",
          "year",
          "semester",
          "targetKind",
          "nodeId",
          "changeKind",
          "occurredAt",
          "eventCount",
          "actorName"
        ]
      }
    },
    {
      "identifier": "roadmap-path-changed",
      "class": "path-change",
      "delivery": "in-app",
      "digest": {
        "mode": "regular-when-events-repeat",
        "windowSeconds": 60,
        "aggregationField": "payload.digestKey",
        "keyFormat": "roadmap:{roadmapId}:general"
      },
      "steps": [
        { "id": "digest", "type": "digest" },
        {
          "id": "in-app",
          "type": "in-app-code",
          "handler": "novu/roadmap-path-changed/in-app.step.tsx"
        }
      ],
      "input": {
        "roadmapId": "uuid",
        "courseCode": "string",
        "year": "number",
        "semester": "number",
        "targetKind": "roadmap",
        "changeKind": "dependency-added | dependency-removed",
        "occurredAt": "ISO-8601 UTC string",
        "eventCount": 1,
        "actorName": "string",
        "noticeTitle": "string",
        "noticeBody": "string",
        "digestKey": "roadmap:{roadmapId}:general"
      },
      "inApp": {
        "singleSubject": "Ruta actualizada",
        "singleBody": "payload.noticeBody",
        "summarySubject": "Resumen de cambios · Roadmap de {courseCode}",
        "summaryBody": "count + payload.noticeBody from latest effective event",
        "data": [
          "roadmapId",
          "courseCode",
          "year",
          "semester",
          "targetKind",
          "changeKind",
          "occurredAt",
          "eventCount",
          "actorName"
        ]
      }
    },
    {
      "identifier": "roadmap-resource-changed",
      "class": "resource-change",
      "delivery": "in-app",
      "digest": {
        "mode": "regular-when-events-repeat",
        "windowSeconds": 60,
        "aggregationField": "payload.digestKey",
        "keyFormat": "roadmap:{roadmapId}:node:{nodeId}"
      },
      "steps": [
        { "id": "digest", "type": "digest" },
        {
          "id": "in-app",
          "type": "in-app-code",
          "handler": "novu/roadmap-resource-changed/in-app.step.tsx"
        }
      ],
      "input": {
        "roadmapId": "uuid",
        "courseCode": "string",
        "year": "number",
        "semester": "number",
        "targetKind": "node",
        "nodeId": "uuid",
        "nodeTitle": "string",
        "changeKind": "resource-added | resource-updated | resource-removed",
        "occurredAt": "ISO-8601 UTC string",
        "eventCount": 1,
        "actorName": "string",
        "resourceTitle": "string",
        "noticeTitle": "string",
        "noticeBody": "string",
        "digestKey": "roadmap:{roadmapId}:node:{nodeId}"
      },
      "inApp": {
        "singleSubject": "payload.noticeTitle",
        "singleBody": "payload.noticeBody",
        "summarySubject": "Resumen de cambios · Nodo «{nodeTitle}»",
        "summaryBody": "count + payload.noticeBody from latest effective event",
        "data": [
          "roadmapId",
          "courseCode",
          "year",
          "semester",
          "targetKind",
          "nodeId",
          "changeKind",
          "occurredAt",
          "eventCount",
          "actorName"
        ]
      }
    },
    {
      "identifier": "roadmap-classification-changed",
      "class": "classification-change",
      "delivery": "in-app",
      "digest": {
        "mode": "regular-when-events-repeat",
        "windowSeconds": 60,
        "aggregationField": "payload.digestKey",
        "keyFormat": "roadmap:{roadmapId}:general"
      },
      "steps": [
        { "id": "digest", "type": "digest" },
        {
          "id": "in-app",
          "type": "in-app-code",
          "handler": "novu/roadmap-classification-changed/in-app.step.tsx"
        }
      ],
      "input": {
        "roadmapId": "uuid",
        "courseCode": "string",
        "year": "number",
        "semester": "number",
        "targetKind": "roadmap",
        "changeKind": "classification-updated",
        "occurredAt": "ISO-8601 UTC string",
        "eventCount": 1,
        "actorName": "string",
        "noticeTitle": "string",
        "noticeBody": "string",
        "digestKey": "roadmap:{roadmapId}:general"
      },
      "inApp": {
        "singleSubject": "payload.noticeTitle",
        "singleBody": "payload.noticeBody",
        "summarySubject": "Resumen de cambios · Roadmap de {courseCode}",
        "summaryBody": "count + payload.noticeTitle and noticeBody from latest effective event",
        "data": [
          "roadmapId",
          "courseCode",
          "year",
          "semester",
          "targetKind",
          "changeKind",
          "occurredAt",
          "eventCount",
          "actorName"
        ]
      }
    }
  ]
}
